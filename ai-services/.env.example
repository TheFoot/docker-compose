# ai-services environment reference — VALUES ARE PLACEHOLDERS.
# Copy to `.env` on smarthome01 and populate from the estate secret store.
# Never commit real values back to this repo. See README.md for the policy.

# LiteLLM gateway
LITELLM_ALLOW_NON_REGISTERED_MODELS=true
LITELLM_MASTER_KEY=<litellm-master-key>
UI_USERNAME=<litellm-admin-ui-user>
UI_PASSWORD=<litellm-admin-ui-password>

# Upstream model providers
OPENAI_API_KEY=<openai-key>
ANTHROPIC_API_KEY=<anthropic-key>

# Spark (local vLLM host)
SPARK_BASE_URL=http://spark.thefootonline.local:8000/v1

# Postgres (backs litellm)
POSTGRES_PASSWORD=<postgres-password>

# n8n
N8N_API_KEY=<n8n-api-key>
RESEND_API_KEY=<resend-api-key>
